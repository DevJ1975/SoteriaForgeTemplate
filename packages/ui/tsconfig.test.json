{
  // Design-token contrast tests ONLY. Deliberately a STANDALONE config (it does
  // NOT extend tsconfig.json, whose `include: ["src"]` would drag every
  // react-native component into the program). We seed the program with just the
  // two RN-free modules — the pure `contrast` math + its test, and the raw
  // `palette` they assert against — and emit CommonJS to `.test-dist/`, which
  // `node --test` runs directly. No `react-native` / `expo-*` may enter this
  // graph; if a future edit makes palette.ts or contrast.ts import RN, this
  // compile (and CI's verify-design-tokens job) breaks loudly. `.test-dist/`
  // mirrors apps/mobile's convention.
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    // Default imports of CommonJS core modules (import assert from 'node:assert/strict')
    // need interop or they compile to `.default` (undefined) under module:commonjs.
    // Required for parity across TS versions — without it CI's tsc@5.9.3 emits a
    // broken default access even though a newer local tsc tolerates it.
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".test-dist",
    "rootDir": "src"
  },
  "include": ["src/palette.ts", "src/a11y/**/*.ts"]
}
