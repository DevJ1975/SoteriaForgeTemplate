# @soteria-forge/web — environment (copy to .env; .env is git-ignored)
#
# CLIENT-SAFE values only. The anon/publishable key is safe to ship in the
# browser bundle precisely because Postgres Row-Level Security is the real gate —
# it grants only what RLS allows for the anon/authenticated roles.
#
# The Supabase SERVICE-ROLE key must NEVER appear here (or anywhere in a client):
# it bypasses RLS. It belongs only in server-side/edge contexts, never in source.

# The Supabase project URL (public).
VITE_SUPABASE_URL=

# The publishable/anon key (client-safe, RLS-protected). NEVER the service-role key.
VITE_SUPABASE_ANON_KEY=
