# apps/mobile — build-time environment (NON-SECRET placeholders only).
#
# Runtime Cognito/AppSync configuration is delivered by amplify_outputs.json
# (generated by `npx ampx sandbox` in backend/), NOT by these vars. Do not put
# credentials here. Copy to `.env` for local development.

# development | preview | production
APP_ENV=development

# How many queued xAPI statements the sync layer uploads per batch.
XAPI_SYNC_BATCH_SIZE=25

# EAS project id — set in app.json extra.eas.projectId once the project exists.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
