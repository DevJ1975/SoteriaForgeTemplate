# Soteria Forge — mobile (Expo) environment template.
# Copy to .env (git-ignored) and fill real values. NEVER commit real keys.
#
# Supabase replaces Cognito/Amplify for auth + data. Variables prefixed
# EXPO_PUBLIC_ are inlined into the client bundle at build time, so ONLY
# client-safe values belong here. The anon/publishable key is client-safe
# because Row-Level Security is the real gate — a client can only ever read or
# write its own tenant's rows. The SERVICE ROLE key is NOT client-safe and must
# never appear in this app or any env file that ships in the bundle.

# Supabase project URL (public — safe to commit).
EXPO_PUBLIC_SUPABASE_URL=https://bgnadngztngkwzneknhd.supabase.co

# Supabase publishable/anon key (client-safe, RLS-protected). PLACEHOLDER — put
# the real value in your git-ignored env file only.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_A8ekb2Fm8XwM2AP8t4FPEg_vWPhsjGQ

# Non-secret build hints (see app.config.ts).
APP_ENV=development
XAPI_SYNC_BATCH_SIZE=25
