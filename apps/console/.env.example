# Soteria Forge — console (Vite/Vue) environment template.
# Copy to .env (git-ignored) and fill real values. NEVER commit real keys.
#
# Supabase replaces Cognito/Amplify for auth + data. Variables prefixed VITE_
# are inlined into the client bundle at build time, so ONLY client-safe values
# belong here. The anon/publishable key is client-safe because Row-Level
# Security is the real gate — a caller can only ever read or write its own
# tenant's rows (super-admin being the one cross-tenant role, one tenant at a
# time). The SERVICE ROLE key is NOT client-safe and must never appear here.

# Supabase project URL (public — safe to commit).
VITE_SUPABASE_URL=https://bgnadngztngkwzneknhd.supabase.co

# Supabase publishable/anon key (client-safe, RLS-protected). PLACEHOLDER — put
# the real value in your git-ignored env file only.
VITE_SUPABASE_ANON_KEY=sb_publishable_A8ekb2Fm8XwM2AP8t4FPEg_vWPhsjGQ
