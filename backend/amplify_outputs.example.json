{
  "$comment": "PLACEHOLDER ONLY — no real ids, endpoints, or secrets. The real amplify_outputs.json is generated by `ampx sandbox` / `ampx generate outputs` at deploy time and is git-ignored. This file documents the shape a client consumes.",
  "version": "1.3",
  "auth": {
    "user_pool_id": "REPLACE_WITH_USER_POOL_ID",
    "aws_region": "us-east-1",
    "user_pool_client_id": "REPLACE_WITH_USER_POOL_CLIENT_ID",
    "identity_pool_id": "REPLACE_WITH_IDENTITY_POOL_ID",
    "standard_required_attributes": ["email"],
    "username_attributes": ["email"],
    "user_verification_types": ["email"],
    "unauthenticated_identities_enabled": false,
    "password_policy": {
      "min_length": 8,
      "require_lowercase": true,
      "require_uppercase": true,
      "require_numbers": true,
      "require_symbols": true
    },
    "groups": [
      { "worker": { "precedence": 3 } },
      { "supervisor": { "precedence": 2 } },
      { "tenant-admin": { "precedence": 1 } },
      { "super-admin": { "precedence": 0 } }
    ]
  },
  "data": {
    "url": "https://REPLACE_WITH_APPSYNC_ID.appsync-api.us-east-1.amazonaws.com/graphql",
    "aws_region": "us-east-1",
    "default_authorization_type": "AMAZON_COGNITO_USER_POOLS",
    "authorization_types": ["AWS_LAMBDA"],
    "model_introspection": {
      "$comment": "Populated by ampx at deploy time. Models: Tenant, User, Course, Module, Lesson, Enrollment, CompletionStatement, VideoAsset."
    }
  },
  "storage": {
    "aws_region": "us-east-1",
    "bucket_name": "REPLACE_WITH_BUCKET_NAME",
    "buckets": [
      {
        "name": "soteriaForgeAssets",
        "bucket_name": "REPLACE_WITH_BUCKET_NAME",
        "aws_region": "us-east-1"
      }
    ]
  }
}
