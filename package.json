{
  "name": "soteria-forge",
  "private": true,
  "version": "0.1.0",
  "description": "Mobile-first, offline-capable, multi-tenant training platform (React Native + Expo, AWS Amplify Gen 2, Cloudflare Stream). Turborepo monorepo.",
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "dev:mobile": "npm run start --workspace @soteria-forge/mobile",
    "dev:console": "npm run dev --workspace @soteria-forge/console",
    "backend:sandbox": "npm run sandbox --workspace @soteria-forge/backend"
  },
  "devDependencies": {
    "turbo": "^2.10.2"
  }
}
